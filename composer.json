{
    "name": "redooor/redminstore",
    "description": "RedminStore is a Laravel 12/13 + Inertia storefront theme for ecommerce sites using RedminPortal as the backend administration tool.",
    "keywords": ["package", "laravel", "redooor", "redmin", "portal", "ecommerce", "frontend", "store", "inertia", "vue", "tailwind"],
    "license": "MIT",
    "authors": [
        {
            "name": "Redooor LLP",
            "email": "support@redooor.com",
            "homepage": "http://www.redooor.com"
        }
    ],
    "require": {
        "php": "^8.2 || ^8.3",
        "laravel/framework": "^12.0 || ^13.0",
        "inertiajs/inertia-laravel": "^2.0",
        "redooor/redminportal": "^2.0 || ^3.0"
    },
    "require-dev": {
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpunit/phpunit": "^11.5 || ^12.5"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../redminportal",
            "options": {
                "symlink": true
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "Redooor\\Redminstore\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Redooor\\Redminstore\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Redooor\\Redminstore\\RedminstoreServiceProvider"
            ],
            "aliases": {
                "Redminstore": "Redooor\\Redminstore\\Facades\\Redminstore"
            }
        }
    }
}
